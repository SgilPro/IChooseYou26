  "categories": [
    {
      "id": "field-control",
      "name_zh": "場地／全隊控速",
      "name_en": "Field / Side Speed Control",
      "scope": "field",
      "description_zh": "直接改變全隊或全場的速度關係：順風讓己方全隊速度加倍，戲法空間讓場上出手順序反轉（慢的先動）。"
    },
    {
      "id": "spread-speed-drop",
      "name_zh": "範圍降速技",
      "name_en": "Spread Speed-Drop Moves",
      "scope": "target",
      "description_zh": "用範圍招式（或場地設置）降低對手速度；可能被特性、道具或屬性免疫。"
    },
    {
      "id": "paralysis",
      "name_zh": "麻痺",
      "name_en": "Paralysis",
      "scope": "target",
      "description_zh": "用麻痺狀態讓單一對手變慢（並有機率無法行動）；電屬性等對象可能免疫。"
    },
    {
      "id": "self-speed-boost",
      "name_zh": "自身加速（天氣／特性）",
      "name_en": "Self Speed Boost",
      "scope": "self",
      "description_zh": "靠天氣、場地或特性條件，讓寶可夢自己的速度提高。"
    },
    {
      "id": "item-speed",
      "name_zh": "道具控速",
      "name_en": "Item-based Speed",
      "scope": "item",
      "description_zh": "靠持有道具提高持有者速度，例如講究圍巾。"
    },
    {
      "id": "temporary",
      "name_zh": "暫時性控速",
      "name_en": "Temporary Turn-Order Manipulation",
      "scope": "temporary",
      "description_zh": "只影響單一回合出手順序的手段，例如延後、您先請、釋陀果。"
    },
    {
      "id": "priority-moves",
      "name_zh": "先制技輸出",
      "name_en": "Priority Moves",
      "scope": "priority",
      "description_zh": "用優先度較高的攻擊招式先行出手，不需要比對手快也能先攻擊。"
    }
  ],
