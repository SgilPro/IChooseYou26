{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgilpro.github.io/IChooseYou26/schema/team.schema.json",
  "title": "Team",
  "description": "一支影片介紹的對戰隊伍（資料線第二層：深度分析）。對應 Notion 的隊伍 DB 概念：name / regulation set(relation) / tags / video url / author / team members(relation)。",
  "type": "object",
  "required": [
    "id",
    "name",
    "video_id",
    "video_url",
    "game",
    "regulation_set_id",
    "author",
    "members",
    "is_members_only",
    "review_status",
    "extracted_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "team_<videoId>[_n]；一支影片多隊時加序號"
    },
    "name": {
      "type": "string",
      "description": "隊伍名。優先用影片標題中的隊伍概念（如「雨天 Mega 具甲武者」），否則用標題"
    },
    "name_source": {
      "type": "string",
      "enum": [
        "title",
        "subtitle",
        "frame",
        "manual",
        "pokepaste"
      ]
    },
    "video_id": {
      "type": "string"
    },
    "video_url": {
      "type": "string",
      "format": "uri"
    },
    "channel_handle": {
      "type": "string"
    },
    "game": {
      "type": "string",
      "enum": [
        "champions",
        "sv",
        "other"
      ]
    },
    "regulation_set_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "FK → regulation_sets.json[].id，例如 champions-m-c"
    },
    "regulation_source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "title",
        "subtitle",
        "date-inferred",
        "manual",
        null
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "FK → tags.json[].slug。第一層只放從標題/隊名既有資訊推得的 tag"
    },
    "tags_source": {
      "type": "string",
      "enum": [
        "title",
        "subtitle",
        "analysis",
        "manual"
      ],
      "description": "title = 僅依標題/隊名；analysis = 未來戰術層分析"
    },
    "author": {
      "type": "string",
      "description": "隊伍作者（預設頻道主 Fiske；字幕/描述提到借用他人隊伍則改）"
    },
    "author_source": {
      "type": "string",
      "enum": [
        "channel",
        "description",
        "subtitle",
        "pinned_comment",
        "manual",
        "pokepaste"
      ]
    },
    "members": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "$ref": "team_member.schema.json"
      }
    },
    "is_members_only": {
      "type": "boolean",
      "description": "影片為會員限定；true 時 members 可能為空殼待補"
    },
    "related_video_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "同一隊伍的延伸影片（例如會員版）"
    },
    "team_code": {
      "type": [
        "string",
        "null"
      ],
      "description": "遊戲內的隊伍分享碼，意義由 game 決定：champions = 隊伍 ID（隊伍表頂端「隊伍ID：XXXXXXXXXX」，10 碼英數）；sv = 租借隊伍代碼。同一隊不會同時有兩種。從畫面讀到才填，沒看到填 null。"
    },
    "sources": {
      "type": "object",
      "description": "本隊資料用到的素材",
      "properties": {
        "subtitle_lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "subtitle_range_s": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "frames_used": {
          "type": "integer"
        },
        "pokepaste_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "整隊抽取信心（六隻種族正確的主觀機率）"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "auto",
        "reviewed",
        "conflict",
        "needs-member-access",
        "manual",
        "members-only-withheld"
      ]
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "隊伍思路摘要（來自字幕）"
    },
    "analysis": {
      "type": [
        "object",
        "null"
      ],
      "description": "選用：結構化的隊伍分析（隊伍詳細頁「隊伍分析」四塊）",
      "properties": {
        "core_offense": {
          "type": [
            "string",
            "null"
          ],
          "description": "核心輸出戰術"
        },
        "speed_control": {
          "type": [
            "string",
            "null"
          ],
          "description": "控速手段"
        },
        "speed_control_core": {
          "type": [
            "array",
            "null"
          ],
          "description": "選用：明確寫在隊伍核心戰術裡的控速手段（用來把控速項目由 Level 2 晉升為 Level 1）。必須有依據，不可憑空推測",
          "items": {
            "type": "object",
            "required": [
              "slot",
              "name_zh",
              "reason"
            ],
            "properties": {
              "slot": {
                "type": "integer",
                "description": "隊員槽位"
              },
              "name_zh": {
                "type": "string",
                "description": "招式／特性／道具中文名（須與隊員實際配置一致）"
              },
              "reason": {
                "type": "string",
                "description": "判斷為核心戰術的依據（引用標題／備註／畫面）"
              }
            }
          }
        },
        "cautions": {
          "type": [
            "string",
            "null"
          ],
          "description": "注意事項"
        },
        "scores": {
          "type": [
            "object",
            "null"
          ],
          "description": "隊伍特性評分（Fiske 影片投影片上的四項評分，原值照抄，不自行評分）。數字越大代表該項越高，「上手難度」越高代表越難上手（以投影片標示為準，agent 須在 sources.scores 寫明判讀依據）",
          "properties": {
            "difficulty": {
              "type": "number",
              "minimum": 1,
              "maximum": 10,
              "description": "上手難度"
            },
            "flexibility": {
              "type": "number",
              "minimum": 1,
              "maximum": 10,
              "description": "操作彈性"
            },
            "stability": {
              "type": "number",
              "minimum": 1,
              "maximum": 10,
              "description": "穩定性"
            },
            "coverage": {
              "type": "number",
              "minimum": 1,
              "maximum": 10,
              "description": "全面程度"
            },
            "scale_max": {
              "type": "number",
              "description": "評分滿分（投影片實際標示，例如 5）"
            }
          }
        },
        "sources": {
          "type": [
            "object",
            "null"
          ],
          "description": "各分析欄位的依據：core_offense / cautions / scores / speed_control_core 各一個字串，格式如「title」「notes」「slide:f_052」「subtitle」，可多個以逗號分隔",
          "properties": {
            "core_offense": {
              "type": [
                "string",
                "null"
              ]
            },
            "cautions": {
              "type": [
                "string",
                "null"
              ]
            },
            "scores": {
              "type": [
                "string",
                "null"
              ]
            },
            "speed_control_core": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "analyzed_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "產生分析的模型/流程版本"
        },
        "analyzed_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "分析時間（ISO）"
        }
      }
    },
    "analysis_derived": {
      "type": [
        "object",
        "null"
      ],
      "description": "選用：由程式依隊伍配置衍生的分析，只出現在合併後的 teams.json（不寫入 teams/<video>.json）",
      "properties": {
        "speed_control": {
          "type": "array",
          "description": "控速手段分類（tools/site/classify-speed-control.mjs；分類表 data/ref/speed-control.json）",
          "items": {
            "type": "object",
            "required": [
              "category",
              "label_zh",
              "via"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "label_zh": {
                "type": "string"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "core",
                  "broad",
                  "cleanup"
                ]
              },
              "level": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ],
                "description": "顯示層級：1 直接顯示；2 次要（折疊）；3 輔助與收殘（折疊，不屬控速討論）"
              },
              "via": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "member_slot": {
                      "type": "integer"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "move",
                        "ability",
                        "item"
                      ]
                    },
                    "level": {
                      "type": "integer",
                      "enum": [
                        1,
                        2,
                        3
                      ]
                    },
                    "promoted": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "name_zh": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "lead_modes": {
      "type": [
        "array",
        "null"
      ],
      "description": "選用：建議首發模式（寶可夢以 species.name_en 表示）",
      "items": {
        "type": "object",
        "properties": {
          "leads": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 2
          },
          "back": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 2
          },
          "strategy": {
            "type": "string"
          }
        }
      }
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "extracted_by": {
      "type": "string",
      "description": "模型/流程版本，例如 fable-5.1/extract-v1"
    },
    "paste_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Showdown 匯出原文（來自 pokepast.es），作為無損交換格式"
    },
    "paste_notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "pokepaste 的 notes 欄"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "所屬賽事 id（data/events/<id>.json）。賽事隊伍才有。"
    },
    "match_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "所屬對戰 id（賽事＋輪次＋選手排序組成，data/events/<event>.json 的 matches[].id）。之後官方 replay 影片依此補齊，不重複建立。"
    },
    "player": {
      "type": [
        "string",
        "null"
      ],
      "description": "賽事選手名稱（與 author 相同；author 欄位另有作者歸屬用途）。"
    },
    "team_signature": {
      "type": [
        "string",
        "null"
      ],
      "description": "配置簽章（物種、特性、道具、性格、招式的雜湊），用來偵測不同選手用同一份配置。"
    },
    "source_t_s": {
      "type": [
        "integer",
        "null"
      ],
      "description": "隊伍表在來源影片中出現的秒數（影片可跳轉）。"
    }
  }
}
